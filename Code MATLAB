%% =========================================================================
%  Mini-projet d'automatique 1GII - Sujet 22 : Ligne de tri automatique par couleur
%  Phases 3 et 4 : modélisation + simulations  (version MATLAB)
%  =========================================================================
%  Exécution : ouvrir ce fichier et cliquer sur "Run" (ou  >> simulation_moteur_tri).
%  Version requise : MATLAB R2018b ou plus récent (fonctions locales en fin de script, xline, NumColumns).
%  Toolbox : AUCUNE obligatoire. Control System Toolbox facultative (figure 10 de validation).
%  Sorties : dossier figures/ (PNG 300 DPI) et dossier resultats/ (CSV).
%  Encodage du fichier : UTF-8 (accents dans les figures).
%
%  Deux fonctions DISTINCTES :
%   (A) Régulation de vitesse : moteur DC + PI + PWM saturée + anti-windup (simulate)
%   (B) Logique de tri : machine à états S0..S7 (run_sorting). Elle ne contient AUCUN
%       calcul de PI : elle lit seulement la vitesse MESURÉE produite par (A).
%
%  Provenance des paramètres :
%   [CdC] donnée du cahier des charges / de l'énoncé
%   [HYP] HYPOTHÈSE DE SIMULATION (valeur provisoire, NON mesurée) -> à remplacer
%  =========================================================================
clear; close all; clc;
here = fileparts(mfilename('fullpath')); if isempty(here), here = pwd; end
figdir = fullfile(here,'figures');   if ~exist(figdir,'dir'), mkdir(figdir); end
resdir = fullfile(here,'resultats'); if ~exist(resdir,'dir'), mkdir(resdir); end

%% =========================================================================
%  1. PARAMÈTRES  (SEULE SECTION À MODIFIER)
%  =========================================================================
P = struct();
% ---- 1.1 Cahier des charges [CdC] ----------------------------------------
P.V_SUP        = 12;      % [CdC] tension d'alimentation = PWM 100 % (V)
P.N_GEAR       = 240;     % [CdC] réducteur 1/240
P.N_REF        = 40;      % [CdC] vitesse de référence du convoyeur (tr/min)
P.CR_FACTOR    = 1.20;    % [CdC] +20 % de couple résistant pendant le fonctionnement
P.CR_OUT_NOM   = 120;     % [CdC] couple résistant nominal côté convoyeur (N.m) -> +20 % = +24 N.m
P.T_MIN_PIECES = 5;       % [CdC] temps minimal entre deux pièces (s)
P.TAUX_MIN     = 90;      % [CdC] taux de tri correct minimal (%)
P.N_PIECES     = 20;      % [CdC] nombre de pièces
% Critères chiffrés du catalogue (non communiqués) : renseigner pour un verdict automatique ([] = non fourni)
P.CDC_DEPASSEMENT_MAX_PCT = [];
P.CDC_TR5_MAX_S           = [];
P.CDC_ERREUR_STAT_MAX_RPM = [];

% ---- 1.2 Moteur DC : paramètres manquants -> HYPOTHÈSES [HYP] -------------
% Compatibles avec Cr = 120 N.m : couple ramené moteur = 120/(240*0.70) = 0,714 N.m (~95 A)
P.R_A      = 0.012;     % [HYP] résistance d'induit (ohm)
P.L_A      = 5.0e-5;    % [HYP] inductance d'induit (H)
P.KT       = 7.5e-3;    % [HYP] constante de couple (N.m/A)
P.KE       = 7.5e-3;    % [HYP] constante de FCEM (V.s/rad)
P.J_EQ     = 1.4e-3;    % [HYP] inertie équivalente ramenée à l'arbre moteur (kg.m^2)
P.F_VISC   = 1.0e-5;    % [HYP] frottement visqueux ramené au moteur (N.m.s/rad)
P.ETA_GEAR = 0.70;      % [HYP] rendement du réducteur

% ---- 1.3 Correcteur PI ----------------------------------------------------
% Kp, Ki de la phase 2 non disponibles : calculés par placement de pôles [HYP].
% Pour imposer vos valeurs (V/(tr/min) et V/(tr/min.s)) :  P.KP_OVERRIDE = ...;  P.KI_OVERRIDE = ...;
P.KP_OVERRIDE  = [];
P.KI_OVERRIDE  = [];
P.PI_WN        = 5.0;   % [HYP] pulsation propre souhaitée (rad/s)
P.PI_ZETA      = 0.9;   % [HYP] amortissement souhaité
P.AW_TT_FACTOR = 0.5;   % [HYP] anti-windup (back-calculation) : Tt = facteur * Ti

% ---- 1.4 Électronique / échantillonnage [HYP] -----------------------------
P.TS            = 0.010; % [HYP] période d'échantillonnage (s)
P.PWM_BITS      = 10;    % [HYP] résolution PWM ESP32 ([] = sans quantification)
P.ENCODER_QUANT = false; % [HYP] true : quantifie la vitesse mesurée
P.ENC_CPR       = 48;    % [HYP] impulsions/tour (arbre moteur)

% ---- 1.5 Convoyeur et tri [HYP] -------------------------------------------
P.R_POULIE  = 0.025;    % [HYP] rayon du tambour (m)
P.L_PIECE   = 0.040;    % [HYP] longueur d'une pièce (m)
P.X_IR      = 0.10;     % [HYP] position cellule IR + capteur couleur (m)
P.X_VOLET   = 0.45;     % [HYP] position du volet (m)
P.D_CAPT    = P.X_VOLET - P.X_IR;   % distance d de  dt = d/v (m)
P.COUL      = [5200 1100 900;       % [HYP] pièce rouge (R,G,B) -> catégorie A / bac 1
               900  1500 5000];     % [HYP] pièce bleue (R,G,B) -> catégorie B / bac 2
P.BRUIT_REL = 0.08;     % [HYP] bruit relatif par canal (écart-type)
P.BRUIT_ABS = 150;      % [HYP] bruit additif (comptes)
P.T_INTEG   = 0.154;    % TCS34725 : 2,4 ms x 64 cycles = 154 ms
P.T_INIT    = 0.5;      % [HYP] durée de S0 (s)
P.T_DEBOUNCE= 0.005;    % [HYP] anti-rebond IR (s)
P.T_MARGE   = 0.25;     % [HYP] maintien du volet après passage (s)
P.T_AVANCE  = 0.15;     % [HYP] avance de commande du volet (s)
P.THETA_N   = 90;       % position neutre (deg)
P.THETA_A   = 60;       % volet vers bac 1 (rouge)
P.THETA_B   = 120;      % volet vers bac 2 (bleu)
P.SERVO_RATE= 500;      % [HYP] vitesse max SG90 (deg/s)
P.THETA_TOL = 8;        % tolérance d'angle (deg)
P.DT        = 0.001;    % pas de la machine à états (s)

% ---- 1.6 Scénarios ---------------------------------------------------------
P.T_BO        = 3;        % durée simulation 1 (s)
P.T_BF        = 6;        % durée simulation 2 (s)
P.T_PERT      = 10;       % instant de la perturbation (s)
P.T_FIN_PERT  = 20;
P.SEQ_T       = [0 6 12]; % simulation 4 : instants (s)
P.SEQ_V       = [30 40 50]; % consignes (tr/min)  [exemple du support]
P.T_FIN_CONS  = 18;
P.T_PERT_TRI  = 60;       % +20 % de couple pendant le tri (s)
P.SEED        = 2026;
P.N_MC        = 2000;     % tirages Monte-Carlo

P = derive(P);

% style graphique
set(groot,'defaultAxesFontSize',9,'defaultAxesXGrid','on','defaultAxesYGrid','on', ...
    'defaultAxesGridLineStyle','--','defaultAxesGridAlpha',0.35,'defaultAxesBox','on', ...
    'defaultLineLineWidth',1.5,'defaultAxesFontName','Times New Roman');
P.C_BO=[0.85 0.33 0.10]; P.C_BF=[0 0.447 0.741]; P.C_ERR=[0.64 0.08 0.18]; P.C_CMD=[0.47 0.67 0.19];
P.FOOT = ['[CdC] 12 V (PWM 100 %) ; réducteur 1/240 ; consigne 40 tr/min ; couple résistant nominal 120 N·m, ' ...
          '+20 % = +24 N·m.   [HYP] R, L, Kt, Ke, J, f, η, gains PI.'];
cr_const  = @(t) P.CR_OUT_NOM;
ref_const = @(t) P.N_REF;
ctrl_bo   = struct('mode','open','duty',P.DUTY_BO);
ctrl_pi   = struct('mode','PI','kp',P.KP,'ki',P.KI,'aw',true);

%% =========================================================================
%  2. PHASE 3 : MODÈLES ET VÉRIFICATION
%  =========================================================================
fprintf('%s\nPHASE 3 - MODÈLES  (paramètres [HYP] à remplacer)\n%s\n',repmat('=',1,78),repmat('=',1,78));
den2 = [P.L_A*P.J_EQ, P.L_A*P.F_VISC+P.R_A*P.J_EQ, P.DEN0];
poles_full = roots(den2);
fprintf('Fonction de transfert complète  W/U = Kt / (LJ p^2 + (Lf+RJ) p + (Rf+KeKt))\n');
fprintf('   pôles : %.2f rad/s et %.2f rad/s\n',poles_full(1),poles_full(2));
fprintf('Modèle simplifié (L -> 0) : tau_m = %.4f s ; Km = %.3f (tr/min conv.)/V ; tau_e/tau_m = %.4f\n', ...
    P.TAU_M,P.KM_RPM,P.TAU_E/P.TAU_M);
fprintf('   Cr nominal = %.0f N.m -> %.3f N.m côté moteur ; +20 %% = %.0f N.m\n',P.CR_OUT_NOM,P.CR_M_NOM,0.2*P.CR_OUT_NOM);
fprintf('   PWM de BO pour %.0f tr/min = %.1f %% (%.2f V) ; vitesse linéaire v = %.4f m/s\n', ...
    P.N_REF,P.DUTY_BO*100,P.DUTY_BO*P.V_SUP,v_lin(P,P.N_REF));
fprintf('Correcteur PI : Kp = %.4f V/(tr/min), Ki = %.4f V/(tr/min.s), Ti = %.4f s\n',P.KP,P.KI,P.TI);
% HBF = CG/(1+CG) : CG = Km(Kp p + Ki)/[p(tau p + 1)]
num_cg  = P.KM_RPM*[P.KP P.KI];
den_cg  = conv([1 0],[P.TAU_M 1]);
hbf_den = polyadd(den_cg,num_cg);
hbf_num = num_cg;
den_lit = [P.TAU_M, 1+P.KM_RPM*P.KP, P.KM_RPM*P.KI];
tf_ok   = all(abs(hbf_den-den_lit) < 1e-9);
poles_bf = roots(hbf_den);
wn   = sqrt(P.KM_RPM*P.KI/P.TAU_M);
zeta = (1+P.KM_RPM*P.KP)/(2*P.TAU_M*wn);
fprintf('HBF(p) = Km(Kp p+Ki)/(tau p^2 + (1+Km Kp) p + Km Ki) -> vérification polynomiale : %d\n',tf_ok);
fprintf('   pôles BF = %s ; stable : %d ; wn = %.3f rad/s ; zeta = %.3f ; HBF(0) = %.6f\n', ...
    mat2str(poles_bf.',4),all(real(poles_bf)<0),wn,zeta,hbf_num(end)/hbf_den(end));
poles_bf3 = roots(polyadd(conv([1 0],den2/den2(3)),num_cg));
fprintf('   BF avec moteur complet (3e ordre) : pôles = %s ; stable : %d\n',mat2str(poles_bf3.',4),all(real(poles_bf3)<0));

% Validation numérique (nécessite Control System Toolbox)
if exist('tf','file')==2 && license('test','Control_Toolbox')
    t  = (0:1e-4:2)';
    Gf = tf(P.KT*P.RADS2RPM/P.N_GEAR, den2);
    Gs = tf(P.KM_RPM,[P.TAU_M 1]);
    yf = step(Gf,t); ys = step(Gs,t);
    dev_models = max(abs(yf-ys))/yf(end)*100;
    A0 = 5; t2 = (0:P.TS:3-P.TS)';
    yth = A0*step(tf(hbf_num,hbf_den),t2);
    cpi = struct('mode','PI','kp',P.KP,'ki',P.KI,'aw',true);
    ss_ = simulate(P,3-P.TS,@(t)A0,@(t)0,cpi,'simple',1);
    sf_ = simulate(P,3-P.TS,@(t)A0,@(t)0,cpi,'full',1);
    n_ = min(numel(yth),numel(ss_.t));
    fprintf('VALIDATION : complet vs simplifié = %.3f %% ; HBF vs simulation (simplifié) = %.3f %% ; (complet) = %.3f %%\n', ...
        dev_models, max(abs(yth(1:n_)-ss_.n(1:n_)))/A0*100, max(abs(yth(1:n_)-sf_.n(1:n_)))/A0*100);
    f = newfig(5.2);
    subplot(2,1,1); plot(t,yf,'Color',P.C_BF); hold on; plot(t,ys,'--','Color',P.C_BO);
    title('Validation du modèle simplifié : échelon de 1 V (boucle ouverte)'); xlabel('Temps (s)'); ylabel('Vitesse (tr/min)');
    legend('Modèle complet (2e ordre)','Modèle simplifié Km/(\tau_m p+1)','Location','southeast');
    subplot(2,1,2); plot(t2,yth,'k'); hold on; plot(ss_.t(1:n_),ss_.n(1:n_),'--','Color',P.C_BF); plot(sf_.t(1:n_),sf_.n(1:n_),':','Color',P.C_ERR);
    title('Validation de H_{BF}(p) (échelon de 5 tr/min)'); xlabel('Temps (s)'); ylabel('Vitesse du convoyeur (tr/min)');
    legend('H_{BF}(p) analytique','Simulation PI - simplifié','Simulation PI - moteur complet','Location','southeast');
    pl_save(f,figdir,'10_validation_modeles.png');
else
    fprintf('(Validation numérique ignorée : Control System Toolbox absente)\n');
end

%% =========================================================================
%  3. PHASE 4 : SIMULATION 1 - BOUCLE OUVERTE
%  =========================================================================
fprintf('\n%s\nPHASE 4 - SIMULATIONS\n%s\n',repmat('=',1,78),repmat('=',1,78));
fprintf('\n--- Simulation 1 : boucle ouverte (PWM constante) ---\n');
d_bo = simulate(P,P.T_BO,ref_const,cr_const,ctrl_bo,'full',1);
writetable(struct2table(d_bo),fullfile(resdir,'sim1_boucle_ouverte.csv'));
m_bo = step_metrics(d_bo.t,d_bo.n,0,P.N_REF,d_bo.duty,0,d_bo.t(end));
fprintf('   PWM = %.2f %% ; vitesse finale = %.3f tr/min ; t_montée = %.3f s ; t_5%% = %.3f s ; dépassement = %.2f %%\n', ...
    P.DUTY_BO*100,m_bo.vfin,m_bo.tr,m_bo.ts,m_bo.os);
f = newfig(5.0);
subplot(2,1,1); plot(d_bo.t,d_bo.n,'Color',P.C_BO); hold on;
plot([0 P.T_BO],[P.N_REF P.N_REF],'--k','LineWidth',1);
plot([0 P.T_BO],[m_bo.vfin m_bo.vfin],':','Color',[.5 .5 .5]);
plot(P.TAU_M,0.632*m_bo.vfin,'ko','MarkerSize',4);
plot([m_bo.ts m_bo.ts],[0 1.1*P.N_REF],'--','Color',[0.49 0.18 0.56],'LineWidth',1);
title('Simulation 1 - Réponse du moteur en boucle ouverte (PWM constante)'); ylabel('Vitesse du convoyeur (tr/min)');
legend('Vitesse mesurée',sprintf('Consigne nominale [CdC] = %.0f tr/min',P.N_REF), ...
    sprintf('Valeur finale = %.2f tr/min',m_bo.vfin),sprintf('t = \\tau_m = %.3f s (63,2 %%)',P.TAU_M), ...
    sprintf('Temps de réponse 5 %% = %.2f s',m_bo.ts),'Location','southeast');
subplot(2,1,2); plot(d_bo.t,d_bo.duty*100,'Color',P.C_CMD); hold on; plot([0 P.T_BO],[100 100],':k','LineWidth',0.9);
ylim([0 108]); xlabel('Temps (s)'); ylabel('Rapport cyclique PWM (%)');
legend('Commande PWM','Limite : 12 V = 100 % [CdC]','Location','southeast');
foot(f,P.FOOT); pl_save(f,figdir,'01_reponse_boucle_ouverte.png');

%% =========================================================================
%  4. SIMULATION 2 - BOUCLE FERMÉE PI
%  =========================================================================
fprintf('\n--- Simulation 2 : boucle fermée avec PI, consigne %.0f tr/min ---\n',P.N_REF);
d_bf = simulate(P,P.T_BF,ref_const,cr_const,ctrl_pi,'full',1);
writetable(struct2table(d_bf),fullfile(resdir,'sim2_boucle_fermee_PI.csv'));
m_bf = step_metrics(d_bf.t,d_bf.n,0,P.N_REF,d_bf.duty,0,d_bf.t(end));
fprintf('   t_montée = %.3f s ; t_rép.5%% = %.3f s ; dépassement = %.2f %% ; erreur statique = %.4f tr/min ; PWM max = %.1f %%\n', ...
    m_bf.tr,m_bf.ts,m_bf.os,m_bf.ess,m_bf.pwm);
% fig 02
f = newfig(3.4);
plot(d_bf.t,d_bf.ref,'--k'); hold on; plot(d_bf.t,d_bf.n,'Color',P.C_BF);
patch([0 3 3 0],[0.95 0.95 1.05 1.05]*P.N_REF,[.5 .5 .5],'FaceAlpha',0.15,'EdgeColor','none');
plot([m_bf.ts m_bf.ts],[0 1.1*P.N_REF],':','Color',[0.49 0.18 0.56]);
xlim([0 3]); title('Simulation 2 - Réponse en boucle fermée avec correcteur PI');
xlabel('Temps (s)'); ylabel('Vitesse du convoyeur (tr/min)');
legend(sprintf('Consigne [CdC] (%.0f tr/min)',P.N_REF),'Vitesse réelle (PI)','Bande ±5 %', ...
    sprintf('t_{r,5%%} = %.2f s',m_bf.ts),'Location','southeast');
text(2.95,28,sprintf('Dépassement = %.1f %%\nErreur statique = %.3f tr/min\nt_m = %.2f s', ...
    m_bf.os,abs(m_bf.ess),m_bf.tr),'HorizontalAlignment','right','BackgroundColor','w','EdgeColor',[.5 .5 .5],'FontSize',8);
foot(f,P.FOOT); pl_save(f,figdir,'02_reponse_boucle_fermee_PI.png');
% fig 03
f = newfig(4.6);
subplot(2,1,1); plot(d_bf.t,d_bf.e,'Color',P.C_ERR); hold on; plot([0 P.T_BF],[0 0],'k','LineWidth',0.8);
title('Simulation 2 - Erreur de vitesse e(t) = consigne - vitesse mesurée'); xlabel('Temps (s)'); ylabel('Erreur (tr/min)');
mz = d_bf.t > m_bf.ts;
subplot(2,1,2); plot(d_bf.t(mz),d_bf.e(mz),'Color',P.C_ERR); hold on; plot([m_bf.ts P.T_BF],[0 0],'k','LineWidth',0.8);
title('Zoom en régime établi (après le temps de réponse à 5 %)'); xlabel('Temps (s)'); ylabel('Erreur (tr/min)');
foot(f,['e(t) = consigne [CdC : 40 tr/min] - vitesse mesurée.   ' P.FOOT]); pl_save(f,figdir,'03_erreur_vitesse.png');
% fig 04
f = newfig(5.0);
subplot(2,1,1); plot(d_bf.t,d_bf.u_dem/P.V_SUP*100,'--','Color',[.5 .5 .5]); hold on;
plot(d_bf.t,d_bf.duty*100,'Color',P.C_CMD); plot([0 P.T_BF],[100 100],':k','LineWidth',0.9);
title('Simulation 2 - Signal de commande PWM'); ylabel('Rapport cyclique (%)');
legend('Commande demandée par le PI (avant saturation)','Commande PWM appliquée (saturée)','Saturation : 12 V = 100 % [CdC]','Location','northeast');
subplot(2,1,2); plot(d_bf.t,d_bf.uP,'Color',[0.49 0.18 0.56]); hold on; plot(d_bf.t,d_bf.uI,'Color',[0.6 0.4 0.2]);
xlabel('Temps (s)'); ylabel('Contribution (V)');
legend('Action proportionnelle K_p e','Action intégrale (état de l''intégrateur)','Location','northeast');
foot(f,P.FOOT); pl_save(f,figdir,'04_commande_PWM.png');

%% =========================================================================
%  5. SIMULATION 3 - COMPARAISON BO / BF
%  =========================================================================
fprintf('\n--- Simulation 3 : comparaison boucle ouverte / boucle fermée ---\n');
d_bo_s = simulate(P,P.T_BF,ref_const,cr_const,ctrl_bo,'full',0.9);  % test additionnel : alimentation -10 %
d_bf_s = simulate(P,P.T_BF,ref_const,cr_const,ctrl_pi,'full',0.9);
cases = {'BO - nominal',d_bo;'BF PI - nominal',d_bf;'BO - alim. -10 % (additionnel)',d_bo_s;'BF PI - alim. -10 % (additionnel)',d_bf_s};
nC = size(cases,1); M3 = zeros(nC,6);
for i = 1:nC
    dd = cases{i,2}; mm = step_metrics(dd.t,dd.n,0,P.N_REF,dd.duty,0,dd.t(end));
    M3(i,:) = [mm.tr mm.ts mm.os mm.ess mm.vfin mm.pwm];
end
tab3 = table(cases(:,1),M3(:,1),M3(:,2),M3(:,3),M3(:,4),M3(:,5),M3(:,6),'VariableNames', ...
    {'Cas','t_montee_s','t_rep5_s','depassement_pct','erreur_statique_rpm','vitesse_finale_rpm','pwm_max_pct'});
writetable(tab3,fullfile(resdir,'tableau_performances.csv')); disp(tab3);
f = newfig(5.2);
subplot(2,1,1); plot(d_bf.t,d_bf.ref,'--k'); hold on; plot(d_bo.t,d_bo.n,'Color',P.C_BO); plot(d_bf.t,d_bf.n,'Color',P.C_BF);
xlim([0 P.T_BF]); title('Simulation 3 - Comparaison boucle ouverte / boucle fermée (nominal)'); ylabel('Vitesse du convoyeur (tr/min)');
legend('Consigne [CdC] 40 tr/min','Boucle ouverte (PWM constante)','Boucle fermée (PI)','Location','southeast');
subplot(2,1,2); plot(d_bo.t,d_bo.duty*100,'Color',P.C_BO); hold on; plot(d_bf.t,d_bf.duty*100,'Color',P.C_BF);
xlim([0 P.T_BF]); ylim([0 105]); xlabel('Temps (s)'); ylabel('Rapport cyclique PWM (%)');
legend('Commande BO','Commande BF (PI, saturée)','Location','northeast');
foot(f,P.FOOT); pl_save(f,figdir,'05_comparaison_BO_BF.png');
f = newfig(3.3);
plot(d_bf.t,d_bf.ref,'--k'); hold on; plot(d_bo_s.t,d_bo_s.n,'Color',P.C_BO); plot(d_bf_s.t,d_bf_s.n,'Color',P.C_BF);
xlim([0 P.T_BF]); title('Test additionnel de robustesse : alimentation réduite de 10 %'); xlabel('Temps (s)'); ylabel('Vitesse du convoyeur (tr/min)');
legend('Consigne','BO - alimentation -10 %','BF PI - alimentation -10 %','Location','southeast');
pl_save(f,figdir,'05b_robustesse_alimentation.png');

%% =========================================================================
%  6. SIMULATION 4 - CHANGEMENT DE CONSIGNE
%  =========================================================================
fprintf('\n--- Simulation 4 : changements de consigne 30 -> 40 -> 50 tr/min ---\n');
ref4 = @(t) interp1(P.SEQ_T,P.SEQ_V,t,'previous','extrap');
d4 = simulate(P,P.T_FIN_CONS,ref4,cr_const,ctrl_pi,'full',1);
writetable(struct2table(d4),fullfile(resdir,'sim4_changement_consigne.csv'));
nS = numel(P.SEQ_T); M4 = zeros(nS,5); labels4 = cell(nS,1);
for j = 1:nS
    ts_ = P.SEQ_T(j); v_ = P.SEQ_V(j);
    if j < nS, t1_ = P.SEQ_T(j+1)-P.TS; else, t1_ = P.T_FIN_CONS; end
    if j == 1, y0_ = 0; else, y0_ = P.SEQ_V(j-1); end
    mm = step_metrics(d4.t,d4.n,y0_,v_,d4.duty,ts_,t1_);
    M4(j,:) = [mm.tr mm.ts mm.os mm.ess mm.pwm]; labels4{j} = sprintf('%.0f -> %.0f tr/min',y0_,v_);
    fprintf('   %18s : t_m = %.3f s ; t_5%% = %.3f s ; D = %.2f %% ; e_s = %.4f ; PWM max = %.1f %%\n', ...
        labels4{j},mm.tr,mm.ts,mm.os,mm.ess,mm.pwm);
