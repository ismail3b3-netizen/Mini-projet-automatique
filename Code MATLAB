%% =========================================================================
%  FONCTIONS LOCALES
%  =========================================================================
function P = derive(P)
    P.RADS2RPM = 60/(2*pi);
    P.RPM2RADS = 1/P.RADS2RPM;
    P.CR_M_NOM = P.CR_OUT_NOM/(P.N_GEAR*P.ETA_GEAR);          % couple ramené au moteur (N.m)
    P.DEN0   = P.R_A*P.F_VISC + P.KE*P.KT;
    P.TAU_M  = P.R_A*P.J_EQ/P.DEN0;                           % constante de temps mécanique (s)
    P.TAU_E  = P.L_A/P.R_A;                                   % constante de temps électrique (s)
    P.KM_RADS = P.KT/P.DEN0;                                  % (rad/s moteur)/V
    P.KM_RPM = P.KM_RADS*P.RADS2RPM/P.N_GEAR;                 % (tr/min convoyeur)/V
    P.KD_RPM = (P.R_A/P.DEN0)*P.RADS2RPM/P.N_GEAR;            % (tr/min convoyeur)/(N.m moteur)
    if isempty(P.KP_OVERRIDE)
        P.KP = (2*P.PI_ZETA*P.PI_WN*P.TAU_M-1)/P.KM_RPM;
        P.KI = P.PI_WN^2*P.TAU_M/P.KM_RPM;
    else
        P.KP = P.KP_OVERRIDE; P.KI = P.KI_OVERRIDE;
    end
    P.TI  = P.KP/P.KI;
    P.KAW = 1/(P.AW_TT_FACTOR*P.TI);
    P.DUTY_BO = (P.N_REF + P.KD_RPM*P.CR_M_NOM)/P.KM_RPM/P.V_SUP;   % PWM constante de la BO
end

function v = v_lin(P,n_rpm)
    v = n_rpm*P.RPM2RADS*P.R_POULIE;                          % vitesse linéaire (m/s)
end

function c = polyadd(a,b)
    n = max(numel(a),numel(b));
    c = [zeros(1,n-numel(a)) a] + [zeros(1,n-numel(b)) b];
end

function p = prctile_(x,q)   % percentile sans toolbox Statistics
    x = sort(x(:)); n = numel(x);
    pos = 1+(n-1)*q/100; lo = floor(pos); hi = ceil(pos);
    p = x(lo)+(pos-lo)*(x(hi)-x(lo));
end

function d = duty_q(P,d)
    if ~isempty(P.PWM_BITS)
        lv = 2^P.PWM_BITS-1; d = round(d*lv)/lv;
    end
end

function n = meas_q(P,n)
    if P.ENCODER_QUANT
        q = 60/(P.ENC_CPR*P.TS*P.N_GEAR); n = round(n/q)*q;
    end
end

function [Ad,Bd] = disc_full(P,Ts)
    % discrétisation exacte (maintien d'ordre zéro), entrées [u ; Cr_moteur]
    A = [-P.R_A/P.L_A, -P.KE/P.L_A; P.KT/P.J_EQ, -P.F_VISC/P.J_EQ];
    B = [1/P.L_A, 0; 0, -1/P.J_EQ];
    M = zeros(4); M(1:2,1:2) = A*Ts; M(1:2,3:4) = B*Ts;
    E = expm(M); Ad = E(1:2,1:2); Bd = E(1:2,3:4);
end

function D = simulate(P,t_end,ref_fn,cr_fn,ctrl,model,vscale)
% Simulation en temps discret (période Ts) : correcteur numérique + moteur intégré exactement.
%   ctrl : struct('mode','open','duty',d)  ou  struct('mode','PI','kp',..,'ki',..,'aw',true/false)
%   model: 'full' (i, w) ou 'simple' (1er ordre) ; vscale : facteur sur la tension appliquée
    Ts = P.TS; nst = round(t_end/Ts); N = nst+1;
    t = zeros(N,1); ref = t; n = t; nmv = t; e = t; u_dem = t; duty = t; uP = t; uI = t; cr = t; ia = t;
    full = strcmp(model,'full');
    if full, [Ad,Bd] = disc_full(P,Ts); x = [0;0]; else, a = exp(-Ts/P.TAU_M); xs = 0; end
    I = 0;
    for k = 1:N
        tk = (k-1)*Ts;
        if full, nk = x(2)*P.RADS2RPM/P.N_GEAR; iak = x(1); else, nk = xs; iak = NaN; end
        nm = meas_q(P,nk);
        rk = ref_fn(tk); crk = cr_fn(tk); cr_m = crk/(P.N_GEAR*P.ETA_GEAR);
        ek = rk-nm;
        if strcmp(ctrl.mode,'open')
            udem = ctrl.duty*P.V_SUP; uPk = NaN; uIk = NaN; dk = duty_q(P,ctrl.duty);
        else
            uPk = ctrl.kp*ek; udem = uPk+I;
            usat = min(max(udem,0),P.V_SUP);              % saturation PWM [0 ; 100 %]
            dk = duty_q(P,usat/P.V_SUP); uIk = I;
            if ctrl.aw                                    % anti-windup : back-calculation
                I = I + Ts*(ctrl.ki*ek + P.KAW*(usat-udem));
            else
                I = I + Ts*ctrl.ki*ek;
            end
        end
        t(k)=tk; ref(k)=rk; n(k)=nk; nmv(k)=nm; e(k)=ek; u_dem(k)=udem; duty(k)=dk; uP(k)=uPk; uI(k)=uIk; cr(k)=crk; ia(k)=iak;
        if k <= nst
            u_app = dk*P.V_SUP*vscale;
            if full
                x = Ad*x + Bd*[u_app; cr_m];
            else
                xs = a*xs + (1-a)*(P.KM_RPM*u_app - P.KD_RPM*cr_m);
            end
        end
    end
    D = struct('t',t,'ref',ref,'n',n,'n_meas',nmv,'e',e,'u_dem',u_dem,'duty',duty,'uP',uP,'uI',uI,'cr',cr,'ia',ia);
end

function tc = cross_t(tt,yy,level,d)
    if d > 0, idx = find(yy>=level,1); else, idx = find(yy<=level,1); end
    if isempty(idx), tc = NaN; return; end
    if idx == 1, tc = tt(1); return; end
    tc = tt(idx-1) + (level-yy(idx-1))*(tt(idx)-tt(idx-1))/(yy(idx)-yy(idx-1));
end

function m = step_metrics(t,y,y0,yf,duty,t0,t1)
% Métriques d'une réponse indicielle sur [t0,t1] (y0 -> yf)
    msk = (t>=t0) & (t<=t1);
    tt = t(msk)-t0; yy = y(msk); d = yf-y0;
    m.tr = cross_t(tt,yy,y0+0.9*d,d) - cross_t(tt,yy,y0+0.1*d,d);   % montée 10-90 %
    out = abs(yy-yf) > 0.05*abs(d);
    if ~any(out)
        m.ts = 0;
    else
        last = find(out,1,'last');
        if last+1 <= numel(tt), m.ts = tt(last+1); else, m.ts = NaN; end
    end
    if d > 0, m.os = max(0,(max(yy)-yf)/abs(d)*100); else, m.os = max(0,(yf-min(yy))/abs(d)*100); end
    nl = max(3,floor(numel(yy)/20));
    m.vfin = mean(yy(end-nl+1:end));
    m.ess  = yf - m.vfin;
    dd = duty(msk); m.pwm = max(dd)*100;
end

function pm = pert_metrics(P,d)
    t = d.t; n = d.n;
    pm.avant = mean(n(t>=P.T_PERT-1 & t<P.T_PERT));
    pm.apres = mean(n(t>=P.T_FIN_PERT-1));
    pm.creux = P.N_REF - min(n(t>=P.T_PERT));
    pm.efin  = P.N_REF - pm.apres;
    band = (abs(n-P.N_REF) > 0.005*P.N_REF) & (t>=P.T_PERT);
    if any(band)
        last = find(band,1,'last');
        if last+1 <= numel(t), pm.trec = t(last+1)-P.T_PERT; else, pm.trec = NaN; end
    else
        pm.trec = 0;
    end
    pm.pwm_av = mean(d.duty(t>=P.T_PERT-1 & t<P.T_PERT))*100;
    pm.pwm_ap = mean(d.duty(t>=P.T_FIN_PERT-1))*100;
end

function [cc,score] = tcs_classify(rgb)
% Décision S4 : indice (R-B)/(R+G+B) > 0 -> catégorie 0 (rouge), sinon 1 (bleue)
    s = sum(rgb);
    if s > 0, score = (rgb(1)-rgb(3))/s; else, score = 0; end
    if score > 0, cc = 0; else, cc = 1; end
end

function rgb = tcs_read(P,col)
% Modèle du TCS34725 : comptes bruts d'une pièce (col = 1 rouge, 2 bleue) ou du fond (col = 0)
    if col > 0, base = P.COUL(col,:); else, base = [150 150 150]; end
    rgb = max(0, base.*(1+P.BRUIT_REL*randn(1,3)) + P.BRUIT_ABS*randn(1,3));
end

function R = run_sorting(P,trace,seed)
% Simulation de N pièces. La machine à états n'utilise QUE la vitesse MESURÉE (n_meas) ;
% la vitesse réelle ne sert qu'à déplacer physiquement les pièces sur le tapis.
    rng(seed);
    DT = P.DT; Np = P.N_PIECES;
    t_f = (0:DT:(trace.t(end)-DT))'; nT = numel(t_f);
    n_true = interp1(trace.t,trace.n,t_f,'linear');
    v = v_lin(P,n_true);
    s = [0; cumsum(0.5*(v(2:end)+v(1:end-1))*DT)];                    % abscisse parcourue par la bande
    idz = min(floor(t_f/P.TS)+1,numel(trace.t));
    n_meas_f = trace.n_meas(idz);                                      % vitesse mesurée (maintien)
    % injection : espacement >= 5 s
    t_first = 6;
    gaps = P.T_MIN_PIECES + 1.5*rand(Np-1,1);
    t_inj = t_first + [0; cumsum(gaps)];
    idx_col = [ones(1,floor(Np/2)) 2*ones(1,Np-floor(Np/2))];
    idx_col = idx_col(randperm(Np))';                                  % 1 = rouge, 2 = bleue
    cat_true = idx_col-1;
    names = {'rouge','bleue'};
    s0 = interp1(t_f,s,t_inj);
    t_at = @(k,xl) interp1(s,t_f,s0(k)+xl);
    t_ir_on = zeros(Np,1); t_ir_off = t_ir_on; t_v_on = t_ir_on; t_v_off = t_ir_on;
    for k = 1:Np
        t_ir_on(k)  = t_at(k,P.X_IR);          t_ir_off(k) = t_at(k,P.X_IR+P.L_PIECE);
        t_v_on(k)   = t_at(k,P.X_VOLET);       t_v_off(k)  = t_at(k,P.X_VOLET+P.L_PIECE);
    end
    ir = false(nT,1); pid = zeros(nT,1);
    for k = 1:Np
        m = (t_f>=t_ir_on(k)) & (t_f<t_ir_off(k)); ir(m) = true; pid(m) = k;
    end
    % --- machine à états ---
    state = 0; theta = P.THETA_N; cmd = P.THETA_N; t_s = 0;
    log_state = zeros(nT,1); log_theta = zeros(nT,1); log_cmd = zeros(nT,1);
    cur = struct(); ev = {}; count = [0 0]; cycle_max = 0;
    step = P.SERVO_RATE*DT;
    for k = 1:nT
        t = t_f(k);
        theta = theta + min(max(cmd-theta,-step),step);               % servo SG90 : vitesse limitée
        switch state
            case 0                                                     % S0 initialisation
                cmd = P.THETA_N;
                if t >= P.T_INIT, state = 1; end
            case 1                                                     % S1 attente
                if ir(k), state = 2; cur = struct('t_det',t,'piece_sensor',pid(k)); end
            case 2                                                     % S2 pièce détectée (anti-rebond)
                if ~ir(k)
                    state = 1; cur = struct();
                elseif t-cur.t_det >= P.T_DEBOUNCE
                    state = 3; t_s = t;
                end
            case 3                                                     % S3 lecture couleur (intégration)
                if t-t_s >= P.T_INTEG
                    if ir(k), col = idx_col(pid(k)); else, col = 0; end
                    cur.rgb = tcs_read(P,col); cur.t_read = t; state = 4;
                end
            case 4                                                     % S4 décision + calcul du délai
                [cc,score] = tcs_classify(cur.rgb);
                v_meas = v_lin(P,n_meas_f(k));
                cur.cat = cc; cur.score = score; cur.v_meas = v_meas;
                if v_meas > 1e-3
                    cur.dt_calc = P.D_CAPT/v_meas;                    % dt = d / v
                    cur.t_act = cur.t_det + cur.dt_calc - P.T_AVANCE;
                    cur.t_rel = cur.t_det + cur.dt_calc + P.L_PIECE/v_meas + P.T_MARGE;
                    state = 5;
                else
                    cur.dt_calc = NaN; cur.t_act_eff = t; cur.t_rel = t; state = 7;
                end
            case 5                                                     % S5 délai de déplacement
                if t >= cur.t_act
                    if cur.cat == 0, cmd = P.THETA_A; else, cmd = P.THETA_B; end
                    cur.t_act_eff = t; state = 6;
                end
            case 6                                                     % S6 actuation
                if t >= cur.t_rel, cmd = P.THETA_N; state = 7; end
            case 7                                                     % S7 comptage / retour au neutre
                if abs(theta-P.THETA_N) < 0.5
                    count(cur.cat+1) = count(cur.cat+1)+1;
                    cur.t_end = t; cycle_max = max(cycle_max,t-cur.t_det);
                    ev{end+1} = cur; cur = struct(); state = 1; %#ok<AGROW>
                end
        end
        log_state(k) = state; log_theta(k) = theta; log_cmd(k) = cmd;
    end
    % --- évaluation (vérité terrain) ---
    det = zeros(Np,1);
    for j = 1:numel(ev), det(ev{j}.piece_sensor) = j; end
    piece = (1:Np)'; couleur = cell(Np,1); t_det = nan(Np,1); Rr = t_det; Gg = t_det; Bb = t_det; score = t_det;
    decide = cell(Np,1); vm = t_det; dtc = t_det; dtr = t_det; errms = t_det; bac_s = cell(Np,1); okv = false(Np,1);
    for k = 1:Np
        mk = (t_f>=t_v_on(k)) & (t_f<=t_v_off(k)); th = log_theta(mk);
        if ~isempty(th) && all(abs(th-P.THETA_A) < P.THETA_TOL), bac = 0;
        elseif ~isempty(th) && all(abs(th-P.THETA_B) < P.THETA_TOL), bac = 1;
        else, bac = -1; end
        couleur{k} = names{idx_col(k)};
        if det(k) > 0
            e = ev{det(k)};
            t_det(k) = e.t_det; Rr(k) = e.rgb(1); Gg(k) = e.rgb(2); Bb(k) = e.rgb(3); score(k) = e.score;
            if e.cat == 0, decide{k} = 'rouge (bac 1)'; else, decide{k} = 'bleue (bac 2)'; end
            vm(k) = e.v_meas; dtc(k) = e.dt_calc; dtr(k) = t_v_on(k)-e.t_det;
            errms(k) = (e.t_det+e.dt_calc-t_v_on(k))*1e3;
            okv(k) = (bac == cat_true(k));
        else
            decide{k} = 'non détectée';
        end
        if bac == 0, bac_s{k} = 'bac 1'; elseif bac == 1, bac_s{k} = 'bac 2'; else, bac_s{k} = 'volet mal positionné'; end
    end
    R.df = table(piece,couleur,t_inj,t_det,Rr,Gg,Bb,score,decide,vm,dtc,dtr,errms,bac_s,okv, ...
        'VariableNames',{'piece','couleur_reelle','t_injection_s','t_detection_s','R','G','B','indice_chromatique', ...
        'categorie_decidee','v_mesuree_m_s','delta_t_calcule_s','delta_t_reel_s','erreur_timing_ms','bac_obtenu','tri_correct'});
    R.t_f = t_f; R.theta = log_theta; R.cmd = log_cmd; R.state = log_state; R.s = s; R.s0 = s0;
    R.t_inj = t_inj; R.t_v_on = t_v_on; R.t_v_off = t_v_off; R.events = ev; R.count = count;
    R.cat_true = cat_true; R.cycle_max = cycle_max; R.gaps = diff(t_inj); R.trace = trace;
end

function plot_tri(P,R,figdir,name,full)
    df = R.df; t_f = R.t_f; Np = P.N_PIECES;
    if full
        t0 = 0; t1 = max(R.t_v_off)+4; h = 8.6;
    else
        t0 = R.t_inj(1)-1; t1 = R.t_v_off(3)+2; h = 8.6;
    end
    f = newfig(h);
    colr = {[0.84 0.15 0.16],[0.12 0.47 0.71]};    % rouge, bleu
    nev = numel(R.events);
    % (a) déplacement des pièces
    a1 = subplot(5,1,1); hold on;
    for k = 1:Np
        ts = linspace(R.t_inj(k),min(R.t_v_off(k)+1,t_f(end)),300);
        x = interp1(t_f,R.s,ts)-R.s0(k);
        plot(ts,x,'Color',colr{R.cat_true(k)+1},'LineWidth',1.0);
        if df.tri_correct(k), plot(R.t_v_on(k),P.X_VOLET,'o','MarkerFaceColor',[0 .5 0],'MarkerEdgeColor',[0 .5 0],'MarkerSize',4);
        else, plot(R.t_v_on(k),P.X_VOLET,'kx','MarkerSize',7,'LineWidth',2); end
        if ~isnan(df.t_detection_s(k)), plot(df.t_detection_s(k),P.X_IR,'^','MarkerFaceColor',[0.49 0.18 0.56],'MarkerEdgeColor','none','MarkerSize',4); end
    end
    plot([t0 t1],[P.X_IR P.X_IR],':','Color',[0.49 0.18 0.56],'LineWidth',0.9);
    plot([t0 t1],[P.X_VOLET P.X_VOLET],':','Color',[.5 .5 .5],'LineWidth',0.9);
    text(t0+0.01*(t1-t0),P.X_IR-0.04,'capteurs IR + couleur','FontSize',7,'Color',[0.49 0.18 0.56]);
    text(t0+0.01*(t1-t0),P.X_VOLET-0.04,'volet de tri','FontSize',7,'Color',[.4 .4 .4]);
    if full
        ylim([-0.04 0.80]);
        text(t1-0.5,0.20,sprintf('Espacement mini mesuré = %.2f s  (CdC : >= %d s)',min(R.gaps),P.T_MIN_PIECES), ...
            'HorizontalAlignment','right','FontSize',7,'Color',[0.49 0.18 0.56],'BackgroundColor','w','EdgeColor',[0.49 0.18 0.56]);
        ttl = sprintf('Simulation 6 - Tri automatique de %d pièces',Np);
    else
        ylim([-0.04 1.32]);
        d0 = df.t_detection_s(1); d1 = df.t_detection_s(2);
        plot([d0 d1],[0.80 0.80],'-','Color',[0.49 0.18 0.56]); plot(d0,0.8,'<','Color',[0.49 0.18 0.56],'MarkerFaceColor',[0.49 0.18 0.56],'MarkerSize',4);
        plot(d1,0.8,'>','Color',[0.49 0.18 0.56],'MarkerFaceColor',[0.49 0.18 0.56],'MarkerSize',4);
        text((d0+d1)/2,0.85,sprintf('%.2f s >= %d s [CdC]',d1-d0,P.T_MIN_PIECES),'HorizontalAlignment','center','FontSize',7,'Color',[0.49 0.18 0.56]);
        plot([d0 R.t_v_on(1)],[0.66 0.66],'-','Color',[.4 .4 .4]); plot(d0,0.66,'<','Color',[.4 .4 .4],'MarkerFaceColor',[.4 .4 .4],'MarkerSize',4);
        plot(R.t_v_on(1),0.66,'>','Color',[.4 .4 .4],'MarkerFaceColor',[.4 .4 .4],'MarkerSize',4);
        text((d0+R.t_v_on(1))/2,0.71,sprintf('\\Deltat = d/v = %.2f s [CdC]',df.delta_t_calcule_s(1)),'HorizontalAlignment','center','FontSize',7,'Color',[.4 .4 .4]);
        ttl = sprintf('Simulation 6 - Tri automatique de %d pièces (zoom sur les 3 premières)',Np);
    end
    h1 = plot(NaN,NaN,'-','Color',colr{1}); h2 = plot(NaN,NaN,'-','Color',colr{2});
    h3 = plot(NaN,NaN,'^','MarkerFaceColor',[0.49 0.18 0.56],'MarkerEdgeColor','none');
    h4 = plot(NaN,NaN,'o','MarkerFaceColor',[0 .5 0],'MarkerEdgeColor',[0 .5 0]); h5 = plot(NaN,NaN,'kx','LineWidth',2);
    legend([h1 h2 h3 h4 h5],{'pièce rouge','pièce bleue','détection IR','arrivée au volet : tri correct','arrivée au volet : tri incorrect'}, ...
        'Location','north','NumColumns',3,'FontSize',6.5);
    title(ttl); ylabel('Position bord avant (m)'); xlim([t0 t1]);
    % (b) détection couleur
    a2 = subplot(5,1,2); hold on;
    for j = 1:nev
        e = R.events{j}; plot(e.t_read,e.score,'s','MarkerFaceColor',colr{e.cat+1},'MarkerEdgeColor','none','MarkerSize',4);
    end
    plot([t0 t1],[0 0],'k','LineWidth',0.8); ylim([-0.75 0.75]); ylabel('Indice (R-B)/(R+G+B)'); xlim([t0 t1]);
    g1 = plot(NaN,NaN,'s','MarkerFaceColor',colr{1},'MarkerEdgeColor','none'); g2 = plot(NaN,NaN,'s','MarkerFaceColor',colr{2},'MarkerEdgeColor','none');
    legend([g1 g2],{'décision : rouge','décision : bleu'},'Location','east','FontSize',6.5);
    % (c) servomoteur
    a3 = subplot(5,1,3); hold on; ylim([55 125]);
    for j = 1:nev
        e = R.events{j};
        patch([e.t_act_eff e.t_rel e.t_rel e.t_act_eff],[55 55 125 125],colr{e.cat+1},'FaceAlpha',0.15,'EdgeColor','none');
    end
    c1 = plot(t_f,R.cmd,'--','Color',[.5 .5 .5],'LineWidth',1); c2 = plot(t_f,R.theta,'Color',P.C_CMD);
    ylabel('Angle servo (deg)'); xlim([t0 t1]); legend([c1 c2],{'commande','position du volet'},'Location','northeast','FontSize',6.5);
    % (d) résultat par pièce
    a4 = subplot(5,1,4); hold on; ylim([0 1]); set(a4,'YTick',[]);
    if full, w = 0.5; else, w = 0.15; end
    for k = 1:Np
        if df.tri_correct(k), cl = [0 .6 0]; else, cl = [0 0 0]; end
        patch(R.t_v_on(k)+[-w w w -w]/2,[0 0 1 1],cl,'FaceAlpha',0.7,'EdgeColor','none');
    end
    text(t0+0.02*(t1-t0),0.5,sprintf('Taux de tri correct = %.0f %%   (CdC : >= %d %%)',R.taux,P.TAUX_MIN),'FontSize',8, ...
        'BackgroundColor','w','EdgeColor',[0 .6 0]);
    ylabel('Résultat'); xlim([t0 t1]);
    % (e) état FSM
    a5 = subplot(5,1,5); stairs(t_f,R.state,'Color',[0.55 0.35 0.2],'LineWidth',1.0);
    set(a5,'YTick',0:7); ylim([-0.3 7.3]); xlim([t0 t1]); xlabel('Temps (s)');
    if full
        set(a5,'YTickLabel',{'S0','S1','S2','S3','S4','S5','S6','S7'});
    else
        set(a5,'YTickLabel',{'S0 Init','S1 Wait','S2 Pièce détectée','S3 Lecture couleur','S4 Décision','S5 Délai','S6 Actuation','S7 Comptage/Retour'},'FontSize',6);
    end
    ylabel('État FSM');
    linkaxes([a1 a2 a3 a4 a5],'x');
    foot(f,sprintf(['[CdC] 20 pièces ; >= 5 s entre pièces ; Δt = d/v ; taux de tri >= 90 %% ; vitesse 40 tr/min ; +20 %% de couple à t = %.0f s.   ' ...
        '[HYP] d, longueur des pièces, couleurs/bruit TCS34725, SG90.'],P.T_PERT_TRI));
    pl_save(f,figdir,name);
end

function f = newfig(h)
    f = figure('Units','inches','Position',[1 1 6.3 h],'Color','w','PaperPositionMode','auto');
end

function foot(f,txt)
% Note de bas de figure : provenance des valeurs ([CdC] = cahier des charges, [HYP] = hypothèse)
    ax = findall(f,'Type','axes');
    for a = ax'
        p = get(a,'Position'); p(2) = 0.085+p(2)*0.915; p(4) = p(4)*0.915; set(a,'Position',p);
    end
    annotation(f,'textbox',[0.01 0.0 0.98 0.07],'String',txt,'EdgeColor','none','FontSize',6.5, ...
        'Color',[.3 .3 .3],'VerticalAlignment','bottom','FitBoxToText','off');
end


function pl_save(f,figdir,name)
% Garder la figure ouverte après le Run
set(f,'PaperPositionMode','auto');

% Sauvegarde PNG haute qualité (300 DPI)
print(f,fullfile(figdir,name),'-dpng','-r300');

% Sauvegarde MATLAB pour réouverture ultérieure
[~,base,~] = fileparts(name);
savefig(f,fullfile(figdir,[base '.fig']));

% Ne pas fermer la figure !
fprintf('   [figure PNG + FIG] figures/%s\n',base);
end


function s = verdict(ok)
    if ok, s = 'conforme'; else, s = 'NON conforme'; end
end

function s = verdict_opt(lim,val)
    if isempty(lim), s = 'n/a'; else, s = verdict(val <= lim); end
end

function s = spec_txt(lim,unit)
    if isempty(lim), s = 'non communiqué'; else, s = sprintf('<= %g %s',lim,unit); end
end
